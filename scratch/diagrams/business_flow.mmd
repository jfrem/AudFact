graph TD
    %% Estilos de nodos
    classDef pos fill:#34d399,stroke:#059669,stroke-width:2px,color:#064e3b;
    classDef mipres fill:#60a5fa,stroke:#2563eb,stroke-width:2px,color:#1e3a8a;
    classDef core fill:#a78bfa,stroke:#7c3aed,stroke-width:2px,color:#3b0764;
    classDef audit fill:#f87171,stroke:#dc2626,stroke-width:2px,color:#7f1d1d;

    subgraph Cadena_Dispensacion [Cadena de Dispensación Farmacéutica]
        direction TB
        M[Médico / Prescriptor] -->|Emite| F[Fórmula Médica]
        E[EPS] -->|Emite| A[Autorización de Entrega]
        D[Discolmets] -->|Entrega al Paciente| AE[Acta de Entrega / Dispensa]
    end

    subgraph Canal_POS [Servicio POS]
        F -->|POS ORD| POS_FM[Fórmula básica CUM]
        A -->|POS AUT| POS_AU[Autorización de Servicio]
        AE -->|POS ANE| POS_AE[Dispensa Física firmada]
    end
    class POS_FM,POS_AU,POS_AE pos;

    subgraph Canal_MIPRES [Servicio MIPRES]
        F -->|MIPRES OPF| MP_FM[Prescripción Minsalud]
        A -->|MIPRES PDE| MP_AU[Direccionamiento PDE]
        AE -->|MIPRES CRC| MP_AE[Acta de Entrega CRC]
        AE -->|Testigo a Ruego FDE| MP_TR[Formato Testigo FDE]
    end
    class MP_FM,MP_AU,MP_AE,MP_TR mipres;

    POS_FM & POS_AU & POS_AE & MP_FM & MP_AU & MP_AE & MP_TR -->|Soportes Escaneados| PDF[Google Drive / SQL BLOB]
    
    subgraph Radicacion [Facturación y Radicación]
        direction LR
        INV[Agrupar en Factura - FacSec] --> PreAudit{¿Pre-Auditoría AudFact?}
        PreAudit -->|Sí| AudFact[Auditoría IA Gemini]
        PreAudit -->|No| RadDirecta[Radicar a EPS sin validar]
        
        AudFact -->|completed: Aprobado| RadSegura[Radicar con Cero Glosas]
        AudFact -->|manual_review: Hallazgos| RevHumana[Corrección por Auditor]
        RevHumana --> RadSegura
        
        RadDirecta --> Glosa[Glosa de Factura - Pérdida de Ingreso]
        RadSegura --> Pago[Pago Exitoso EPS - ROI 100%]
    end
    class AudFact,PreAudit core;
    class Glosa,RadDirecta audit;
    class Pago,RadSegura pos;
