graph TD
    classDef ci fill:#eff6ff,stroke:#3b82f6,stroke-width:2px,color:#1e3a8a;
    classDef registry fill:#faf5ff,stroke:#a855f7,stroke-width:2px,color:#581c87;
    classDef cd fill:#fef2f2,stroke:#ef4444,stroke-width:2px,color:#7f1d1d;
    classDef health fill:#f0fdf4,stroke:#22c55e,stroke-width:2px,color:#14532d;

    subgraph GitHub_Actions_CI [Fase 1: Integración Continua CI]
        Push[Push / PR a main] --> CI_Trigger[GitHub Actions Workflow]
        CI_Trigger --> Lint[Code Linters & Static Analysis]
        CI_Trigger --> BuildFE[Vite / Next.js Bundle Compilation]
        CI_Trigger --> Tests[PHPUnit Unit & Integration Tests]
    end
    class Push,CI_Trigger,Lint,BuildFE,Tests ci;

    subgraph GHCR_Docker_Registry [Fase 2: Construcción e Inmutabilidad]
        Tests -->|Pasan con éxito| BuildImages[Build Multi-stage Docker Images]
        BuildImages --> PHPImage[ghcr.io/jfrem/audfact-php:SHA]
        BuildImages --> NginxImage[ghcr.io/jfrem/audfact-nginx:SHA]
        BuildImages --> FEImage[ghcr.io/jfrem/audfact-frontend:SHA]
        PHPImage & NginxImage & FEImage -->|Push to Registry| GHCR[GitHub Container Registry]
    end
    class BuildImages,PHPImage,NginxImage,FEImage,GHCR registry;

    subgraph LAN_Production_CD [Fase 3: Despliegue Continuo CD - Runner Self-Hosted]
        GHCR -->|Trigger Deploy| Runner[Runner en Host de Producción: 172.16.0.3]
        Runner --> GitPull[Git pull solo orquestación y docker-compose]
        Runner --> Preflight[SQL Preflight: Verifica Schema & Conexión DB]
        Runner --> DockerPull[Docker pull desde GHCR]
        Runner --> ComposeUp[docker compose -f docker-compose.prod.yml up -d]
    end
    class Runner,GitPull,Preflight,DockerPull,ComposeUp cd;

    subgraph Post_Deployment [Fase 4: Verificación & Purga Zero-Source]
        ComposeUp --> HealthLoop{Healthcheck Status Loop}
        HealthLoop -->|Falla o Timeout| Rollback[Rollback Automático a Tag Anterior]
        HealthLoop -->|Exitoso - 200 OK| Purge[Zero-Source Host Purge: Borra código del Host]
        Purge --> Final[Sistema operativo inmutable en producción]
    end
    class HealthLoop,Rollback,Purge,Final health;
