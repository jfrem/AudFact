# ══════════════════════════════════════════════════════════════════
# .dockerignore — AudFact
# Estrategia: excluir todo lo no-runtime, luego re-incluir
# explícitamente lo que necesita docs.Dockerfile.
# ══════════════════════════════════════════════════════════════════

# ── Control de versiones ──
.git
.gitignore

# ── Secretos locales ──
.env
.env.*
!.env.example

# ── Dependencias locales (se instalan dentro de la imagen) ──
node_modules
vendor
frontend/node_modules
frontend/.next
frontend/.turbo

# ── Logs y temporales ──
logs
responseIA
tmp
*.log
public/mcp/node_modules
public/mcp/build
coverage
.nyc_output
dist
build

# ── Herramientas de desarrollo y testing ──
.github/
.claude/
tests/
phpunit.xml
.phpunit.cache
.env.dev
.env.test

# ── Agentes de IA ──
.agent/
.agents/
skills-lock.json

# ── IDEs y entornos ──
.vscode/
.devcontainer/
.roo/

# ── Documentación: excluir por defecto ──
*.md

# ── Frontend: excluido del build backend ──
frontend/

# ══════════════════════════════════════════════════════════════════
# EXCEPCIONES para docs.Dockerfile
# Estos archivos se necesitan en el contexto de build porque
# docs.Dockerfile los copia al portal Docusaurus.
# ══════════════════════════════════════════════════════════════════
!plans/
!plans/**
!README.md
!BUSINESS.md
!DESIGN.md
!website/
!website/**

# ── Re-excluir artefactos pesados DESPUÉS de la re-inclusión ──
# (en .dockerignore la última regla que coincide gana)
website/node_modules
website/.docusaurus
website/build
