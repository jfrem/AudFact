# Metadatos del controlador de versiones
.git
.gitignore

# Secretos locales (NO deben entrar al contexto de build)
.env
.env.*
!.env.example

# Dependencias locales (dev)
node_modules
vendor
frontend/node_modules
frontend/.next
frontend/.turbo

# Logs y Temporales
logs
responseIA
tmp
*.log
public/mcp/node_modules
public/mcp/build
coverage
.nyc_output
dist
build

# Herramientas de Desarrollo y Testing
.github/
.claude/
tests/
phpunit.xml
.phpunit.cache
.env.dev
.env.test

# Documentación y Planes
plans/
*.md
.agent/
.agents/
skills-lock.json

# ── Excepciones para el build de Docusaurus (docs.Dockerfile) ──
# El Dockerfile de docs necesita estas rutas en el contexto de build.
!plans/
!README.md
!BUSINESS.md
!DESIGN.md
!website/

# IDEs y Entornos
.vscode/
.devcontainer/
.roo/

# Frontend no participa en build de imágenes backend actuales
frontend/
