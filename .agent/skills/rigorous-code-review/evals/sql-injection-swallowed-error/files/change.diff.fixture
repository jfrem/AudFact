diff --git a/src/application/finishAudit.ts b/src/application/finishAudit.ts
index 56b67eb..670e705 100644
--- a/src/application/finishAudit.ts
+++ b/src/application/finishAudit.ts
@@ -4,6 +4,10 @@ export async function finishAudit(
   repo: AuditRepositoryPort,
   record: AuditRecord,
 ): Promise<{ ok: boolean }> {
-  await repo.save({ ...record, status: "COMPLETADO" });
+  try {
+    await repo.save({ ...record, status: "COMPLETADO" });
+  } catch {
+    // el reporte ya se envió al cliente; no tiene sentido fallar aquí
+  }
   return { ok: true };
 }
