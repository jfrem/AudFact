import type { GoogleGenAI } from "@google/genai";
import { z } from "zod";
import type {
  AIProviderPort,
  ExtractionResult,
  ExtractionSchema,
  NormalizedDocument,
} from "../../domain/ports/AIProviderPort.js";

export class GeminiAdapter implements AIProviderPort {
  constructor(private readonly client: GoogleGenAI) {}

  async extract(document: NormalizedDocument, schema: ExtractionSchema): Promise<ExtractionResult> {
    const response = await this.client.models.generateContent({
      model: "gemini-2.5-flash",
      contents: document.pages.map((p) => p.text ?? "").join("\n"),
      config: { responseMimeType: "application/json", responseJsonSchema: z.toJSONSchema(schema) },
    });
    const fields = schema.parse(JSON.parse(response.text ?? "{}"));
    return { fields, visualEvidence: [] };
  }
}
