APP_ENV=development
WRAP_API_BASE=http://nginx
WWWUSER_ID=1000
WWWGROUP_ID=1000
AUDFACT_API_PUBLIC_URL=http://localhost:8080
INTERNAL_API_URL=http://127.0.0.1:8080
AUDFACT_FRONTEND_PUBLIC_URL=http://localhost:3000

AUDFACT_PHP_IMAGE=ghcr.io/jfrem/audfact-php
AUDFACT_NGINX_IMAGE=ghcr.io/jfrem/audfact-nginx
AUDFACT_FRONTEND_IMAGE=ghcr.io/jfrem/audfact-frontend
AUDFACT_IMAGE_TAG=latest
AUDFACT_FRONTEND_HOST_PORT=3100

NEXT_PUBLIC_APP_NAME=AudFact
NEXT_PUBLIC_DEFAULT_THEME=dark
NEXT_PUBLIC_POLLING_JOBS_MS=5000
NEXT_PUBLIC_POLLING_HEALTH_MS=30000
NEXT_PUBLIC_LOCALE=es-CO
NEXT_PUBLIC_TIMEZONE=America/Bogota

WEBHOOK_URL=http://localhost:8080/app/wrap/webhook.php
CAPABILITIES_URL=http://localhost:8080/app/wrap/capabilities.php
MCP_WEBHOOK_SECRET=your_secure_random_string_here

DB_TYPE=sqlsrv
DB_HOST=localhost
DB_PORT=1433
DB_NAME=mi_base
DB_USER=sa
DB_PASS=

DB2_HOST=localhost
DB2_PORT=1433
DB2_NAME=mi_base_secundaria
DB2_USER=sa
DB2_PASS=

DB_POOLING=1
DB2_POOLING=1
DB_ENCRYPT=no
DB_TRUST_SERVER_CERT=yes
DB2_ENCRYPT=no
DB2_TRUST_SERVER_CERT=yes

GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_TLS_VERIFY=1

REQUEST_TIMEOUT_MS=60000
LOG_LEVEL=info
LOG_RETENTION_DAYS=7
LOG_MAX_SIZE_MB=10
AUDIT_RESPONSE_IA_ENABLED=1
AUDIT_RESPONSE_IA_DIR=/var/www/html/logs/responseIA
ALLOWED_ORIGINS=http://localhost:3000
MAX_JSON_SIZE=1048576

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_TEMPERATURE=0.0
GEMINI_TIMEOUT=300
GEMINI_TOP_P=1.0
GEMINI_TOP_K=1
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_MEDIA_RESOLUTION=medium
GEMINI_THINKING_BUDGET=
GEMINI_THINKING_LEVEL=
GEMINI_EXTRACTION_MAX_OUTPUT_TOKENS=4096
GEMINI_EXTRACTION_THINKING_BUDGET=
GEMINI_EXTRACTION_THINKING_LEVEL=MINIMAL
GEMINI_SEMANTIC_MAX_OUTPUT_TOKENS=2048
GEMINI_SEMANTIC_THINKING_LEVEL=
GEMINI_SEMANTIC_THINKING_BUDGET=
GEMINI_SEED=42

AUDIT_BATCH_MAX_LIMIT=100
AUDIT_BATCH_CRON_LIMIT=5000
AUDIT_BATCH_TIMEOUT=3600
AUDIT_NGINX_READ_TIMEOUT=3600
AUDIT_FPM_TERMINATE_TIMEOUT=3600

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PREFIX=audfact:
REDIS_PASSWORD=
REDIS_MAXMEMORY=4gb
REDIS_MAXMEMORY_POLICY=volatile-lru
REDIS_CONTAINER_MEMORY=5G
REDIS_MODE=standalone
REDIS_PERSISTENT=0

CB_GEMINI_THRESHOLD=3
CB_GEMINI_COOLDOWN=60

AUDIT_INTERNAL_API_BASE=http://nginx
AUDIT_WORKER_ORCHESTRATOR_REPLICAS=3
AUDIT_WORKER_DOWNLOADER_REPLICAS=8
AUDIT_WORKER_EXTRACTION_REPLICAS=8
AUDIT_WORKER_NORMALIZER_REPLICAS=2
AUDIT_WORKER_POLICY_REPLICAS=2
AUDIT_WORKER_PERSISTENCE_REPLICAS=3
AUDIT_WORKER_BATCH_REPLICAS=2
AUDIT_IDEMPOTENCY_KEY_TTL=300
AUDIT_JOB_TTL=604800
AUDIT_STATE_TTL=604800
AUDIT_PERSISTENCE_QUEUE_TTL=604800
AUDIT_RESERVATION_TTL=86400
AUDIT_PENDING_RECLAIM_IDLE_MS=600000
AUDIT_PENDING_RECLAIM_INTERVAL_MS=30000
AUDIT_EVENT_MAX_RETRIES=3
AUDIT_STREAM_BLOCK_MS=5000
AUDIT_DLQ_STREAM=audit.dlq

AUDIT_CACHE_TTL=604800
AUDIT_EXTRACTION_CACHE_TTL=604800

