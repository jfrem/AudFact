# ── Aplicación ──
# development | production
APP_ENV=development
WRAP_API_BASE=http://nginx
WWWUSER_ID=1000
WWWGROUP_ID=1000
NEXT_PUBLIC_API_URL=http://localhost:8080

WEBHOOK_URL=http://localhost:8080/app/wrap/webhook.php
CAPABILITIES_URL=http://localhost:8080/app/wrap/capabilities.php
MCP_WEBHOOK_SECRET=your_secure_random_string_here

# ── Base de datos principal (conexión "default" — escritura) ──
# INSERT/UPDATE/DELETE/MERGE se ejecutan contra esta conexión.
DB_TYPE=sqlsrv
DB_HOST=localhost\SQL2022
DB_PORT=1433
DB_NAME=mi_base
DB_USER=sa
DB_PASS=

# ── Base de datos de consulta (conexión "db2" — lectura) ──
# SELECT/consultas se ejecutan contra esta conexión.
DB2_HOST=localhost\SQL2022_REPLICA
DB2_PORT=1433
DB2_NAME=mi_base
DB2_USER=sa
DB2_PASS=

# ── Opciones compartidas de conexión ──
DB_POOLING=1
# Producción temporal en este entorno: desactivar cifrado SQL Server y aceptar el certificado del servidor.
# Objetivo futuro: migrar a DB_ENCRYPT=yes, DB2_ENCRYPT=yes y trust estricto con certificado válido.
DB_ENCRYPT=no
DB_TRUST_SERVER_CERT=yes
DB2_ENCRYPT=no
DB2_TRUST_SERVER_CERT=yes

# ── Google Drive (Service Account) ──
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_TLS_VERIFY=1

# ── General ──
REQUEST_TIMEOUT_MS=60000
LOG_LEVEL=info
LOG_RETENTION_DAYS=7
LOG_MAX_SIZE_MB=10
# Produccion: lista separada por comas (sin espacios), ej:
# ALLOWED_ORIGINS=https://app.empresa.com,https://admin.empresa.com
# ALLOWED_ORIGINS=
MAX_JSON_SIZE=1048576

# ── Gemini AI ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_TEMPERATURE=0.0
GEMINI_TIMEOUT=300
# Determinismo: topP=1.0 + topK=1 + temperature=0 = máxima consistencia
GEMINI_TOP_P=1.0
GEMINI_TOP_K=1
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_RESPONSE_MIME=application/json
GEMINI_MEDIA_RESOLUTION=MEDIA_RESOLUTION_HIGH
GEMINI_THINKING_BUDGET=
GEMINI_THINKING_LEVEL=
GEMINI_EXTRACTION_MAX_OUTPUT_TOKENS=4096
GEMINI_EXTRACTION_THINKING_BUDGET=
GEMINI_EXTRACTION_THINKING_LEVEL=MINIMAL
GEMINI_SEMANTIC_MAX_OUTPUT_TOKENS=2048
GEMINI_SEMANTIC_THINKING_LEVEL=
GEMINI_SEMANTIC_THINKING_BUDGET=
# Seed para reproducibilidad de auditorías (RECOMENDADO en prod: 42)
# Sin seed, el modelo NO intenta determinismo y los resultados pueden variar entre llamadas idénticas.
GEMINI_SEED=42

# ── Timeouts de Auditoría (centralizados) ──
AUDIT_BATCH_MAX_LIMIT=100
AUDIT_BATCH_TIMEOUT=3600
AUDIT_NGINX_READ_TIMEOUT=3600
AUDIT_FPM_TERMINATE_TIMEOUT=3600

# ── Redis (caché distribuida, circuit breaker, rate limiting) ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PREFIX=audfact:
# IMPORTANTE: Este valor debe coincidir con el default de docker-compose.yml (--requirepass)
REDIS_PASSWORD=audfact_dev_default
# Modo de conexión: standalone | sentinel | cluster (default: standalone)
REDIS_MODE=standalone
# Solo para modo sentinel: lista de sentinels (host1:port1,host2:port2)
# REDIS_SENTINELS=sentinel1:26379,sentinel2:26379,sentinel3:26379
# REDIS_SENTINEL_SERVICE=mymaster
# Solo para modo cluster: lista de nodos (host1:port1,host2:port2)
# REDIS_CLUSTER_NODES=redis1:6379,redis2:6379,redis3:6379
# Conexiones persistentes (0=deshabilitado, 1=habilitado, requiere PHP-FPM)
REDIS_PERSISTENT=0

# ── Circuit Breaker (Gemini API) ──
# Fallos consecutivos antes de abrir el circuito
CB_GEMINI_THRESHOLD=3
# Segundos de enfriamiento antes de half-open
CB_GEMINI_COOLDOWN=60

# ── Caché de Auditoría ──
# TTL en segundos para resultados de auditoría en Redis (default: 24h)
AUDIT_CACHE_TTL=86400
# TTL en segundos para cache documental por document_hash (default: 24h)
AUDIT_EXTRACTION_CACHE_TTL=86400

# ── Pipeline event-driven (Redis Streams) ──
# Bloqueo de XREADGROUP en milisegundos para los workers de auditoría
AUDIT_STREAM_BLOCK_MS=5000
# Reintentos por evento antes de enviarlo a la DLQ
AUDIT_EVENT_MAX_RETRIES=3
# Nombre del stream de dead-letter
AUDIT_DLQ_STREAM=audit.dlq
# Base URL interna que los workers usan para consumir la API REST interna
AUDIT_INTERNAL_API_BASE=http://nginx
# Versiones usadas para trazabilidad en los eventos
AUDIT_VERSION_EXTRACTOR=gemini-3.x-parallel-fc-v1
AUDIT_VERSION_NORMALIZER=1.0.0
AUDIT_VERSION_RULES=1.0.0

# ── Seguridad en Producción ──
# IMPORTANTE: En producción, NO almacene secretos en este archivo.
# Opciones recomendadas:
#   1. Docker secrets:  docker secret create db_pass <file>
#   2. Azure Key Vault: az keyvault secret set --vault-name X --name DB_PASS --value Y
#   3. Variables de entorno del sistema (no archivos .env)
# Secretos a migrar: DB_PASS, DB2_PASS, GEMINI_API_KEY, GOOGLE_DRIVE_PRIVATE_KEY, MCP_WEBHOOK_SECRET, REDIS_PASSWORD
